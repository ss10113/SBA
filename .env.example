# ==============================================================================
# SBA GOVWIN - FEDERAL PROCUREMENT CAPTURE & BID STRATEGY PLATFORM
# Environment Variables & Deployment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. AI PLATFORM & AGENT CONFIGURATION (SELF-HOSTED VM OR CLOUD)
# ------------------------------------------------------------------------------
# Provider Options: 'gemini' | 'ollama' | 'openai-compatible' | 'custom'
AI_PROVIDER=gemini

# Google Gemini API Key
# Obtain free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Name
# Gemini models: 'gemini-2.5-flash', 'gemini-2.5-pro'
# Ollama models: 'llama3.3:latest', 'qwen2.5:32b', 'mistral:latest'
AI_MODEL=gemini-2.5-flash

# Base URL (Leave empty for default cloud endpoints, or set for local Ollama / home VM)
# Example for local Ollama on same host: http://localhost:11434/v1
# Example for remote home VM: http://192.168.1.100:11434/v1
AI_BASE_URL=

# ------------------------------------------------------------------------------
# 2. SAM.GOV FEDERAL OPPORTUNITIES API (OPTIONAL)
# ------------------------------------------------------------------------------
# Public API key for live opportunity streaming from GSA
# Request at: https://open.gsa.gov/api/get-opportunities-public-api/
# When omitted, system serves the authentic 213-record federal benchmark database
SAM_GOV_API_KEY=

# SAM.gov Environment: 'alpha' (api-alpha.sam.gov) or 'production' (api.sam.gov)
SAM_GOV_ENV=production
