rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Synced Opportunities Collection (Live site cache for SAM.gov & gov portals)
    match /syncedOpportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(opportunityId)
        && incoming().noticeId is string
        && incoming().title is string
        && incoming().syncedAt is string;
      allow update: if isSignedIn()
        && isValidId(opportunityId)
        && incoming().noticeId is string
        && incoming().syncedAt is string;
      allow delete: if isSignedIn();
    }

    // Pipeline Items
    match /pipeline/{pipelineId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(pipelineId)
        && incoming().userId == request.auth.uid
        && incoming().noticeId is string;
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Proposal Revisions
    match /proposalRevisions/{revisionId} {
      allow read: if isSignedIn() && existing().authorId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(revisionId)
        && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn()
        && existing().authorId == request.auth.uid
        && incoming().authorId == request.auth.uid;
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Market Intel Reports Cache
    match /marketIntelReports/{reportId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reportId) && incoming().queryKey is string;
      allow update: if isSignedIn() && isValidId(reportId) && incoming().queryKey is string;
      allow delete: if isSignedIn();
    }
  }
}
